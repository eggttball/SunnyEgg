# By default the script reads only exported FB environment variables.
# To configure an already-running agent, copy this reference to local ignored .env,
# fill it in locally, and explicitly run:
# python3 scripts/facebook.py fetch --env-file .env --lookback-days 30 --max-pages 4
# The loader reads ONLY the explicitly named file. It accepts the listed keys as
# literal assignments (optional matching quotes), with no shell execution,
# interpolation, automatic dotenv lookup, or shell-profile reads.
# Exported FB variables take precedence over file values, including empty exports.
# Use a token with approved access to the requested Page. Never commit a real token,
# send it to the frontend, or paste it into a chat. A parent's personal token is
# not assumed sufficient to read an external Page. Depending on the app/use case,
# approved permissions or Page Public Content Access may be required by Meta.
# Page Public Content Access does not guarantee downloadable video source.
# The supplied video is a Reel; current fetch does not implement its own Reels edge.
# Cloud jobs inject these variables from a secret store. The current hybrid
# flow still uses a dedicated browser login to discover recent posts.
FB_ACCESS_TOKEN=
# Required: an enabled Graph API version from YOUR Meta app (vMAJOR.MINOR).
# No supported version is guessed or selected automatically.
FB_GRAPH_VERSION=
FB_PAGE_ID=
# Optional for exchanging a valid User token into an approximately 60-day token.
# Use the SAME Meta app that issued FB_ACCESS_TOKEN. Get these from App settings.
# App Secret stays on the backend; never send it to the frontend or this chat.
FB_APP_ID=
FB_APP_SECRET=
