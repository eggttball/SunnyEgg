[Unit]
Description=SunnyEgg photo collection and recognition
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sunnyegg
WorkingDirectory=/opt/sunnyegg
EnvironmentFile=/opt/sunnyegg/.env
ExecStart=/opt/sunnyegg/.venv/bin/python /opt/sunnyegg/scripts/scheduler.py --once --root /opt/sunnyegg
TimeoutStartSec=30min
