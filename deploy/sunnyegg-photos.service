[Unit]
Description=SunnyEgg photo collection and recognition
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sunnyegg
WorkingDirectory=/opt/sunnyegg
EnvironmentFile=/opt/sunnyegg/.env
ExecStart=/usr/bin/node /opt/sunnyegg/scripts/firebase-worker.mjs --schedule-only
TimeoutStartSec=30min
